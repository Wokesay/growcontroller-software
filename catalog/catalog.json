        "sourceEn": "Athena Blended Feed Program A01.004 (metric)",
        "basis": "RAT-066",
        "ec": 2.1, "ph": [5.8, 6.2],
        "steps": [
          { "role": "b", "name": "Grow B", "pair": "AB", "mlPerL": 2.9 },
          { "role": "a", "name": "Grow A", "pair": "AB", "mlPerL": 2.9 },
          { "role": "calmag", "name": "CaMg", "mlPerL": 1.0 }
        ]
      },
      {
        "id": "athena_blended_bloom", "name": "Athena Blended – Blüte", "nameEn": "Athena Blended – Flowering",
        "note": "Blüte Woche 1–2 (ab Woche 3 höher, mit PK). Mit dem aktuellen Herstellerplan abgleichen.",
        "noteEn": "Flowering weeks 1–2 (higher from week 3, with PK). Check against the current manufacturer chart.",
        "source": "Athena Blended Feed Program A01.004 (metrisch)",
        "sourceEn": "Athena Blended Feed Program A01.004 (metric)",
        "basis": "RAT-066",
        "ec": 2.3, "ph": [5.8, 6.2],
        "steps": [
          { "role": "b", "name": "Bloom B", "pair": "AB", "mlPerL": 3.2 },
          { "role": "a", "name": "Bloom A", "pair": "AB", "mlPerL": 3.2 },
          { "role": "calmag", "name": "CaMg", "mlPerL": 1.0 }
        ]
      }
    ]
  }
}
