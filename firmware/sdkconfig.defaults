# SPDX-License-Identifier: AGPL-3.0-or-later
# For both boards; flash, partitions and memory per board in boards/*.defaults
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y
# Zwei App-Partitionen mit Rückfall nach misslungenem Selbsttest
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# nlohmann/json braucht Ausnahmen
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Octal PSRAM on both boards (16 MB on the N32R16V, 8 MB on the N8R8): history, JSON
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_FREERTOS_HZ=1000
# No Bluetooth yet: for sensors (PD-153) it comes as a passive observer only,
# never for setup (SD-070). JTAG over USB stays on until the firmware cuts it
# at run time (SD-070, EN 18031 GEC)
CONFIG_BT_ENABLED=n
